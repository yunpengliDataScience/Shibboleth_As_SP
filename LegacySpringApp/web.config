<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
				<!--
            Rule 1:
            Preserve URLs that already contain /LegacySpringApp.
            Prevents duplicating the application context path.
				-->
				<rule name="LegacySpringApp Existing Context"
					  stopProcessing="true">

					<match url="^LegacySpringApp(?:/.*)?$"
						   ignoreCase="true" />

					<action type="Rewrite"
							url="http://127.0.0.1:9093/{R:0}"
							appendQueryString="true" />
				</rule>
		
                <rule name="Spring Boot Reverse Proxy">
                    <match url="^(.*)$" />
                    <conditions>
                        <add input="{URL}" pattern="^/Shibboleth\.sso(?:/|$)" negate="true" />
                    </conditions>
                    <serverVariables>
                    </serverVariables>
                    <action type="Rewrite" url="http://127.0.0.1:9093/LegacySpringApp/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
