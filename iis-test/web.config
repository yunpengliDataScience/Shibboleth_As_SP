<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Spring Boot Reverse Proxy">
                    <match url="^(.*)$" />
                    <conditions>
                        <add input="{URL}" pattern="^/Shibboleth\.sso(?:/|$)" negate="true" />
                    </conditions>
                    <serverVariables>
                    </serverVariables>
                    <action type="Rewrite" url="http://127.0.0.1:9091/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
